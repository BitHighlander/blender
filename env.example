# Blender Sidecar Environment Configuration Example
# Copy this file to .env and customize for your environment

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis connection URL
# Format: redis://[:password@]host:port/db
# For TLS: rediss://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Redis Streams for command/reply
REDIS_CMD_STREAM=blender:cmd
REDIS_REPLY_STREAM=blender:reply
REDIS_EVENTS_STREAM=blender:events
REDIS_METRICS_STREAM=blender:metrics

# Redis consumer group and worker name
REDIS_CONSUMER_GROUP=cg:dev
REDIS_CONSUMER_NAME=worker-01

# ============================================================================
# Sidecar Configuration
# ============================================================================

# Unique worker identifier (defaults to hostname if not set)
SIDECAR_WORKER_ID=worker-dev-01

# Log level: DEBUG, INFO, WARNING, ERROR
SIDECAR_LOG_LEVEL=DEBUG

# Sidecar version (informational)
SIDECAR_VERSION=1.0.0-dev

# ============================================================================
# Paths Configuration
# ============================================================================

# Root directories for assets, builds, and temp files
PATHS_ASSETS_ROOT=./assets
PATHS_BUILD_ROOT=./build
PATHS_TMP_ROOT=./tmp

# ============================================================================
# Feature Flags
# ============================================================================

# Enable Zstandard compression for payloads
FEATURES_USE_ZSTD=false

# Enable MessagePack encoding
FEATURES_USE_MSGPACK=false

# Allow fallback to UI operators (use false in production)
FEATURES_ALLOW_OPS_FALLBACK=true

# Enable detailed profiling per command
FEATURES_ENABLE_PROFILING=true

# Enable trace/span correlation
FEATURES_ENABLE_TRACING=true

# ============================================================================
# Resource Limits
# ============================================================================

# Maximum objects per scene
LIMITS_MAX_OBJECTS=10000

# Maximum GLB export size in MB
LIMITS_MAX_GLB_MB=100

# Command timeout in milliseconds (60000 = 1 minute)
LIMITS_CMD_TIMEOUT_MS=60000

# Heartbeat interval in seconds
LIMITS_HEARTBEAT_INTERVAL_SEC=10

# Maximum operations in a Batch command
LIMITS_MAX_BATCH_OPS=100

# ============================================================================
# Blender Configuration
# ============================================================================

# Disable global undo during operations (recommended for performance)
BLENDER_DISABLE_UNDO=true

# Optional: path to startup .blend file
# BLENDER_STARTUP_BLEND=/path/to/factory.blend

# Prefix for temporary .blend files
BLENDER_TEMP_BLEND_PREFIX=sidecar_

